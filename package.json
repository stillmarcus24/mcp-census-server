  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "evals": "node dist/evals/evals.js",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.7.0",
    "typescript": "^5.9.3"
  }
